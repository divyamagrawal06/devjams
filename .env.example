# Cockroach Cloud. Copy CONNECTION_STRING from the operator env.
# Do not commit real credentials.
CONNECTION_STRING="postgresql://user:pass@host:26257/defaultdb?sslmode=verify-full"
DATABASE_URL="postgresql://user:pass@host:26257/defaultdb?sslmode=verify-full"

# Windows CA cert (from the Cockroach console):
# New-Item -ItemType Directory -Force "$env:APPDATA\postgresql"
# Invoke-WebRequest -Uri https://cockroachlabs.cloud/clusters/<cluster-id>/cert -OutFile "$env:APPDATA\postgresql\root.crt"

AWS_REGION="ap-south-1"
# Leave AWS_PROFILE unset to use the default (root) credentials.
# AWS_PROFILE=

INTERNAL_API_KEY=""
TELEMETRY_PRIVACY_KEY=""

# Optional Dodo Payments connector. Configure every field or none of them.
# BETTER_AUTH_URL must be HTTPS outside localhost because it is used as the
# hosted checkout return/cancel origin.
BETTER_AUTH_URL="http://localhost:3000"
DODO_PAYMENTS_API_KEY=""
DODO_PAYMENTS_WEBHOOK_KEY=""
DODO_PAYMENTS_ENVIRONMENT="test_mode"
DODO_STANDARD_PRODUCT_ID=""
DODO_PRO_PRODUCT_ID=""
MINECRAFT_ROUTE_DOMAIN="mc.indexd.app"
FARLANDS_VELOCITY_SECRET_NAME="velocity-forwarding-secret"
FARLANDS_VELOCITY_SECRET_KEY="forwarding.secret"
FARLANDS_ARTIFACT_FETCH_IMAGE="registry.example/farlands/artifact-fetch@sha256:<64-hex-digest>"
FARLANDS_WORLD_SYNC_IMAGE="registry.example/farlands/world-sync@sha256:<64-hex-digest>"

# Shared cluster namespaces on farlands-dev
FARLANDS_SYSTEM_NAMESPACE="farlands-system"
FARLANDS_PROXY_NAMESPACE="infra-team"
FARLANDS_BACKEND_NAMESPACE="dev-deployment"
BACKUP_NAMESPACE="infra-team"
FARLANDS_BACKUP_WORKER_ROLE_ARN=""
FARLANDS_BACKUP_WORKER_SERVICE_ACCOUNT="backup-orchestrator"
S3_BUCKET=""
S3_PREFIX="farlands-live"
