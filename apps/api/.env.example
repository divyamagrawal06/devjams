# Comma-separated, exact email addresses allowed to access /api/admin.
# Keep real addresses in an ignored .env.local file or deployment environment.
ADMIN_EMAIL_ALLOWLIST="admin@example.com"

# Copy to .env and fill values before running the backend
# Backend will read env vars at startup (via dotenv)

# Database — Cockroach Cloud (same cluster as the repo-root CONNECTION_STRING).
# Do not commit real credentials. Place them in an ignored .env.
DATABASE_URL="postgresql://user:pass@host:26257/defaultdb?sslmode=verify-full"

# Authentication
MOCK_USER_ID="" # Optional seed identity only; never bypasses request authentication
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Dodo Payments. Leave all fields empty to keep paid plans honestly disabled.
# Use HTTPS for BETTER_AUTH_URL outside localhost; it becomes the checkout
# return/cancel origin. Webhook payloads are accepted only after signature
# verification at POST /api/billing/webhooks/dodo.
DODO_PAYMENTS_API_KEY=""
DODO_PAYMENTS_WEBHOOK_KEY=""
DODO_PAYMENTS_ENVIRONMENT="test_mode"
DODO_STANDARD_PRODUCT_ID=""
DODO_PRO_PRODUCT_ID=""

# Service-to-service authentication for internal cluster routes.
# Use one high-entropy value shared only with trusted in-cluster callers.
INTERNAL_API_KEY=""

# Durable deployment worker bounds. The worker heartbeats every 20 seconds, so
# the default 60-second lease permits restart takeover without a long blind spot.
DEPLOY_CONCURRENCY="1"
DEPLOY_LEASE_MS="60000"

# Reviewed helper images used in live deployment paths. Both values are
# required and must include a full immutable registry digest.
FARLANDS_ARTIFACT_FETCH_IMAGE="registry.example/farlands/artifact-fetch@sha256:<64-hex-digest>"
FARLANDS_WORLD_SYNC_IMAGE="registry.example/farlands/world-sync@sha256:<64-hex-digest>"

# OAuth (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Blob runtime (optional)
BLOB_READ_WRITE_TOKEN=""
RUNTIME_JAR_BLOB_PATHNAME=""

# AWS / S3 for backups
AWS_REGION=""
S3_BUCKET=""
S3_PREFIX="infra-team"
# Optional backup-specific overrides. Empty values fall back to S3_BUCKET and
# S3_PREFIX respectively.
BACKUP_BUCKET=""
BACKUP_S3_PREFIX=""
BACKUP_DOWNLOAD_URL_TTL_SECONDS="300"
BACKUP_TEMP_SIZE_LIMIT="25Gi"
# Required for Minecraft provisioning and manual backup Jobs. Terraform writes
# these values to the farlands-backup-worker-identity ConfigMap in production.
FARLANDS_BACKUP_WORKER_ROLE_ARN=""
FARLANDS_BACKUP_WORKER_SERVICE_ACCOUNT="backup-orchestrator"

# Catalog reconciliation only; weekly backup creation is owned by the
# Kubernetes CronJob and is not duplicated inside the API process.
BACKUP_SYNC_ENABLED="false"
BACKUP_SYNC_INTERVAL_MS="300000"

# Public weekly policy readback (UTC), kept aligned with the cluster CronJob.
BACKUP_SCHEDULE_ENABLED="true"
BACKUP_SCHEDULE_DAY_OF_WEEK="0"
BACKUP_SCHEDULE_HOUR_UTC="3"
BACKUP_SCHEDULE_MINUTE_UTC="0"
BACKUP_RETENTION_COUNT="3"

# AWS credentials (for local testing only). Prefer IAM roles in production.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# Farlands-specific AWS settings (used by infra tooling)
FARLANDS_AWS_ACCOUNT_ID=""
FARLANDS_EKS_ASSUME_ROLE=""
FARLANDS_EKS_ASSUME_ROLE_ARN=""

# Kubernetes / backup job settings
BACKUP_NAMESPACE="infra-team"
BACKUP_IMAGE_ARCHIVE="alpine:3.20@sha256:d9e853e87e55526f6b2917df91a2115c36dd7c696a35be12163d44e6e2a4b6bc"
BACKUP_IMAGE_UPLOAD="amazon/aws-cli:2.15.0@sha256:e2a778146a45cb7cdcc55e3051c0de38ea9f180ed88383447f7ead6b0ba5e9a4"
# Legacy fallback; FARLANDS_BACKUP_WORKER_SERVICE_ACCOUNT takes precedence.
BACKUP_SERVICE_ACCOUNT="backup-orchestrator"
BACKUP_CRONJOB_NAME="server-backup-orchestrator"

# Notes:
# - Set `MOCK_USER_ID` to a user that owns the server you want to test. You can
#   find a valid user id from the database or create a test user in the app.
# - Start the backend with dotenv loaded (bun will load .env when using dotenv in code):
#
#   bun run --watch src/index.ts
#
# - Then trigger a manual backup:
#
#   curl -X POST "http://localhost:3001/api/servers/<serverId>/backups" \
#     -H "Content-Type: application/json" \
#     -d '{"name":"manual backup"}'
